# Skill Service LLM 配置
# 从 ~/.skill-service/models-config.yaml 自动生成
# 生成时间: 2025-03-19

# 设置当前使用的模型（使用下划线命名）
SKILL_SERVICE_LLM_CURRENT=anthropic

# ============================================
# Claude 配置 (Anthropic)
# ============================================
SKILL_SERVICE_LLM_CLAUDE_PROVIDER=anthropic
SKILL_SERVICE_LLM_CLAUDE_MODEL=claude-3-sonnet-20240229
SKILL_SERVICE_LLM_CLAUDE_API_KEY=${ANTHROPIC_API_KEY}
SKILL_SERVICE_LLM_CLAUDE_DESCRIPTION=Anthropic Claude 3 Sonnet

# ============================================
# 豆包 Pro 配置 (Doubao/火山引擎)
# ============================================
SKILL_SERVICE_LLM_DOUBAO_PRO_PROVIDER=custom
SKILL_SERVICE_LLM_DOUBAO_PRO_MODEL=doubao-pro-32k
SKILL_SERVICE_LLM_DOUBAO_PRO_API_KEY=${DOUBAO_API_KEY}
SKILL_SERVICE_LLM_DOUBAO_PRO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SKILL_SERVICE_LLM_DOUBAO_PRO_DESCRIPTION=豆包 Pro 32K 模型
SKILL_SERVICE_LLM_DOUBAO_PRO_MAX_TOKENS=4000
 
# ============================================
# GPT-5 配置 (OpenAI)
# ============================================
SKILL_SERVICE_LLM_GPT_3_5_PROVIDER=openai
SKILL_SERVICE_LLM_GPT_3_5_MODEL=gpt-5
SKILL_SERVICE_LLM_GPT_3_5_API_KEY=${OPENAI_API_KEY}
SKILL_SERVICE_LLM_GPT_3_5_DESCRIPTION=OpenAI GPT-5

# ============================================
# GPT-4 配置 (OpenAI)
# ============================================
SKILL_SERVICE_LLM_GPT_4_PROVIDER=openai
SKILL_SERVICE_LLM_GPT_4_MODEL=gpt-4
SKILL_SERVICE_LLM_GPT_4_API_KEY=${OPENAI_API_KEY}
SKILL_SERVICE_LLM_GPT_4_DESCRIPTION=OpenAI GPT-4

# ============================================
# GPT-4o 配置 (OpenAI)
# ============================================
SKILL_SERVICE_LLM_MY_OPENAI_PROVIDER=openai
SKILL_SERVICE_LLM_MY_OPENAI_MODEL=gpt-4o
SKILL_SERVICE_LLM_MY_OPENAI_API_KEY=${OPENAI_API_KEY}
SKILL_SERVICE_LLM_MY_OPENAI_DESCRIPTION=我的 OpenAI GPT-4o

# ============================================
# 本地 LM Studio 配置
# ============================================
SKILL_SERVICE_LLM_LOCAL_LMSTUDIO_PROVIDER=local
SKILL_SERVICE_LLM_LOCAL_LMSTUDIO_MODEL=local-model
SKILL_SERVICE_LLM_LOCAL_LMSTUDIO_BASE_URL=http://localhost:1234/v1
SKILL_SERVICE_LLM_LOCAL_LMSTUDIO_DESCRIPTION=本地 LM Studio 模型

# ============================================
# 本地 Ollama 配置
# ============================================
SKILL_SERVICE_LLM_LOCAL_OLLAMA_PROVIDER=local
SKILL_SERVICE_LLM_LOCAL_OLLAMA_MODEL=llama2
SKILL_SERVICE_LLM_LOCAL_OLLAMA_BASE_URL=http://localhost:11434/v1
SKILL_SERVICE_LLM_LOCAL_OLLAMA_DESCRIPTION=本地 Ollama 模型
